# Kharidino production environment
# Copy this file to .env or configure these values in the hosting environment.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Optional Kharidino AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional initial administrator bootstrap
KHARIDINO_ADMIN_EMAIL=admin@example.com
KHARIDINO_ADMIN_PASSWORD=replace-with-a-strong-password
KHARIDINO_ADMIN_NAME=مدیر سایت
