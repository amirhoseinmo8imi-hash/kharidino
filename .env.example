# Kharidino production environment
# Generate long random values and keep them outside Git.
SECRET_KEY=replace-with-a-long-random-secret
KHARIDINO_PRODUCTION=1
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Public URL used in links sent by email. Example: https://kharidino.example
PUBLIC_BASE_URL=

# Free email password recovery (standard SMTP; Gmail is supported by default).
# For Gmail, enable 2-Step Verification and create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-gmail-address@gmail.com

# Payment
# Keep disabled until the provider account, callback URL and production smoke test are ready.
PAYMENT_PROVIDER=disabled
PAYMENT_TEST_MODE=0
PAYMENT_CALLBACK_SECRET=replace-with-a-random-callback-secret
PAYMENT_HTTP_TIMEOUT=10

# NextPay: required only when PAYMENT_PROVIDER=nextpay.
# Never commit the real API key.
NEXTPAY_API_KEY=replace-with-provider-api-key

# Optional AI provider
OPENAI_API_KEY=
