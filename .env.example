# Kharidino production environment
# Generate a long random value and keep it outside Git.
SECRET_KEY=replace-with-a-long-random-secret
KHARIDINO_PRODUCTION=1
FLASK_DEBUG=0
HOST=0.0.0.0
PORT=5000

# Payment
# Keep 0 until a real gateway adapter and its provider credentials are configured.
PAYMENT_TEST_MODE=0
PAYMENT_CALLBACK_SECRET=replace-with-a-random-callback-secret

# Optional AI provider
OPENAI_API_KEY=
